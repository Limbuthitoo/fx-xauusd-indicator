{
  "name": "@orb-guide/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:no-worker": "EMBEDDED_MARKET_DATA_WORKER=false tsx watch src/server.ts",
    "dev:worker": "EMBEDDED_MARKET_DATA_WORKER=false tsx watch src/market-data-worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/market-data-worker.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/infrastructure/db/migrate.ts",
    "db:seed": "tsx src/infrastructure/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/websocket": "^8.3.1",
    "@orb-guide/liquidity-sweep-engine": "0.1.0",
    "@orb-guide/range-engine": "0.1.0",
    "@orb-guide/risk-engine": "0.1.0",
    "@orb-guide/shared-types": "0.1.0",
    "@orb-guide/strategy-engine": "0.1.0",
    "fastify": "^4.28.1",
    "firebase-admin": "^14.2.0",
    "ioredis": "^5.11.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
