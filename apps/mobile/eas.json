{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local",
    "promptToConfigurePushNotifications": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://192.168.1.100:7073"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-apk": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://192.168.1.100:7073"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://fx.bijaysubbalimbu.com.np",
        "NODE_ENV": "production"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-apk": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://fx.bijaysubbalimbu.com.np",
        "NODE_ENV": "production"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
